<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.diovamny</groupId>
        <artifactId>inertia-parent</artifactId>
        <version>0.0.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.diovamny.inertia</groupId>
    <artifactId>inertia-tck</artifactId>
    <packaging>jar</packaging>

    <name>Inertia.js v3 Technology Compatibility Kit</name>

    <properties>
        <!-- JaCoCo line floor, calibrated 2026-09-24 (measured 31.9%;
             mostly fixtures; the normative assertions live in adapters). -->
        <jacoco.line.minimum>0.25</jacoco.line.minimum>
        <!-- PIT floors, calibrated 2026-09-25 (measured 32% line, 32% kill). -->
        <pit.mutation.minimum>25</pit.mutation.minimum>
        <pit.coverage.minimum>25</pit.coverage.minimum>
    </properties>
    <description>Executable normative protocol suite (YAML) plus a stack-agnostic
        HTTP runner used to certify the Spring and Quarkus adapters</description>

    <dependencyManagement>
        <dependencies>
            <!-- The parent BOM pins junit-platform 6.x, which is incompatible
                 with the JUnit 5.13 engine used here; force the 1.13.4 line. -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>1.13.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>1.13.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.13.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- 2.18.11: fixes CVE-2026-54512/13/14/15 (gate failBuildOnCVSS=8) -->
            <version>2.18.11</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.13.4</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
